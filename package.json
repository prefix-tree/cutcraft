{
  "name": "cutcut",
  "private": true,
  "version": "0.0.0",
  "description": "A video-editing DSL: a model writes a TSX file, the browser renders it, the editor edits the same file.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:gen": "tsx scripts/gen-docs.ts",
    "docs:graphics": "pnpm --filter @cutcut/render catalog"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "vitepress": "1.6.4",
    "zod": "^4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bsnisar/cutcut.git"
  },
  "homepage": "https://bsnisar.github.io/cutcut/",
  "bugs": {
    "url": "https://github.com/bsnisar/cutcut/issues"
  },
  "license": "MIT",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "node-av"
    ]
  }
}
