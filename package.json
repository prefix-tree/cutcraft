{
  "name": "cutcut",
  "version": "0.0.0",
  "private": true,
  "description": "A video-editing DSL: a model writes a TSX file, the browser renders it, the editor edits the same file.",
  "license": "MIT",
  "homepage": "https://prefix-tree.github.io/cutcraft/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prefix-tree/cutcraft.git"
  },
  "bugs": {
    "url": "https://github.com/prefix-tree/cutcraft/issues"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:gen": "tsx scripts/gen-docs.ts",
    "docs:bench": "tsx scripts/site-bench.ts",
    "docs:graphics": "pnpm --filter @cutcut/render catalog"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "vitepress": "1.6.4",
    "zod": "^4.6.7"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "node-av"
    ],
    "patchedDependencies": {
      "@mediabunny/server@1.62.1": "patches/@mediabunny__server@1.62.1.patch"
    }
  }
}
