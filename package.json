{
  "name": "uberscene-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "A video-editing DSL: a model writes a TSX file, the browser renders it, the editor edits the same file.",
  "license": "MIT",
  "homepage": "https://uberscene.prefixtree.xyz/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prefix-tree/uberscene.git"
  },
  "bugs": {
    "url": "https://github.com/prefix-tree/uberscene/issues"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "test": "pnpm -r test",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs && pnpm --filter @uberscene/editor-app build --base /editor/ --outDir ../../../docs/.vitepress/dist/editor --emptyOutDir",
    "docs:preview": "vitepress preview docs",
    "docs:gen": "tsx scripts/gen-docs.ts",
    "docs:check": "node --import tsx scripts/gen-docs.ts --check && tsx packages/editor/scripts/registry.ts --check",
    "registry:build": "tsx packages/editor/scripts/registry.ts",
    "docs:test": "node --import tsx --test scripts/generated-files.test.ts scripts/skill.test.ts scripts/stage-release.test.mjs",
    "docs:bench": "tsx scripts/site-bench.ts",
    "docs:examples": "pnpm --filter @uberscene/example-showcase docs",
    "blocks:previews": "tsx packages/render/scripts/block-previews.ts",
    "build": "pnpm -r build",
    "format": "biome format --write .",
    "fix": "biome check --write .",
    "prepare": "lefthook install",
    "changeset": "changeset",
    "release": "node scripts/stage-release.mjs",
    "check:packages": "node scripts/check-packages.mjs",
    "knip": "knip",
    "native:build": "cargo build --release --manifest-path native/Cargo.toml",
    "native:test": "cargo test --release --manifest-path native/Cargo.toml",
    "native:check": "cargo fmt --manifest-path native/Cargo.toml --check && cargo clippy --release --all-targets --manifest-path native/Cargo.toml -- -D warnings",
    "test:coverage": "pnpm -r test --coverage --coverage.reporter=text-summary --coverage.reporter=json-summary --coverage.reporter=html"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.6.4",
    "@changesets/cli": "^3.0.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@uberscene/sdk": "workspace:*",
    "@uberscene/player": "workspace:*",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2",
    "knip": "^6.44.1",
    "lefthook": "2.2.2",
    "publint": "^0.3.25",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "^0.23.4",
    "tsx": "catalog:",
    "vitepress": "1.6.4",
    "zod": "catalog:"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "lefthook"
    ]
  }
}
