{
  "name": "cutcut",
  "version": "0.0.0",
  "private": true,
  "description": "A video-editing DSL: a model writes a TSX file, the browser renders it, the editor edits the same file.",
  "license": "MIT",
  "homepage": "https://prefix-tree.github.io/cutcraft/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prefix-tree/cutcraft.git"
  },
  "bugs": {
    "url": "https://github.com/prefix-tree/cutcraft/issues"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "test": "pnpm -r test",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:gen": "tsx scripts/gen-docs.ts",
    "docs:bench": "tsx scripts/site-bench.ts",
    "docs:graphics": "pnpm --filter @cutcraft/render catalog",
    "docs:previews": "pnpm --filter @cutcraft/render previews",
    "docs:examples": "pnpm --filter @cutcraft/example-showcase docs",
    "build": "pnpm -r build",
    "format": "biome format --write .",
    "fix": "biome check --write .",
    "prepare": "lefthook install",
    "changeset": "changeset",
    "release": "changeset publish",
    "check:packages": "node scripts/check-packages.mjs",
    "knip": "knip",
    "test:coverage": "pnpm -r test --coverage --coverage.reporter=text-summary --coverage.reporter=json-summary --coverage.reporter=html"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.6.4",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "knip": "^6.44.1",
    "lefthook": "2.2.2",
    "publint": "^0.3.25",
    "tsdown": "^0.23.4",
    "tsx": "catalog:",
    "vitepress": "1.6.4",
    "zod": "catalog:"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "lefthook",
      "node-av"
    ],
    "patchedDependencies": {
      "@mediabunny/server@1.62.1": "patches/@mediabunny__server@1.62.1.patch"
    }
  }
}
