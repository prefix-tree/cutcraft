{
  "name": "@cutcut/render",
  "version": "0.1.0",
  "private": true,
  "description": "A headless render engine: a cut file to MP4 or WebM in Node, with no browser.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "cutcut-render": "./src/cli.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "bench": "tsx bench/render.bench.ts"
  },
  "dependencies": {
    "@cutcut/kit": "workspace:*",
    "@cutcut/player": "workspace:*",
    "@fontsource/inter": "^5.2.0",
    "@mediabunny/server": "^1.62.1",
    "mediabunny": "1.62.0",
    "react": "^19.3.1",
    "satori": "^0.63.2",
    "skia-canvas": "^4.0.0",
    "tsx": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "eslint": "^9.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
