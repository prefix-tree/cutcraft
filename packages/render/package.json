{
  "name": "@cutcraft/render",
  "version": "0.1.0",
  "description": "A headless render engine: a cut file to MP4 or WebM in Node, with no browser.",
  "license": "MIT",
  "homepage": "https://prefix-tree.github.io/cutcraft/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prefix-tree/cutcraft.git",
    "directory": "packages/render"
  },
  "bugs": {
    "url": "https://github.com/prefix-tree/cutcraft/issues"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.mjs",
      "./cli": "./dist/cli.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/cli.ts src/worker.ts --dts",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "bench": "tsx bench/render.bench.ts",
    "bench:scenarios": "tsx bench/scenarios.bench.ts",
    "test:browser": "vitest run -c vitest.browser.config.ts",
    "catalog": "tsx scripts/graphics-catalog.ts",
    "previews": "tsx scripts/docs-previews.ts"
  },
  "dependencies": {
    "@cutcraft/graphics": "workspace:*",
    "@cutcraft/kit": "workspace:*",
    "@cutcraft/player": "workspace:*",
    "@fontsource/dm-sans": "catalog:",
    "@fontsource/inter": "catalog:",
    "@fontsource/jetbrains-mono": "catalog:",
    "@fontsource/playfair-display": "catalog:",
    "@fontsource/space-grotesk": "catalog:",
    "@mediabunny/server": "^1.62.1",
    "mediabunny": "catalog:",
    "node-av": "^6.1.1",
    "react": "catalog:",
    "satori": "^0.63.2",
    "skia-canvas": "^4.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "react-dom": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
