{
  "name": "@cutcraft/render",
  "version": "0.1.0",
  "description": "The export: a cut file to MP4, WebM, MP3 or WAV, drawn by the real player in headless Chrome.",
  "keywords": [
    "video",
    "video-editing",
    "react",
    "tsx",
    "llm",
    "ai-video",
    "export",
    "mp4",
    "webm",
    "headless"
  ],
  "license": "MIT",
  "homepage": "https://prefix-tree.github.io/cutcraft/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prefix-tree/cutcraft.git",
    "directory": "packages/render"
  },
  "bugs": {
    "url": "https://github.com/prefix-tree/cutcraft/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.mjs",
      "./cli": "./dist/cli.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/cli.ts --dts && vite build -c src/web/vite.config.ts",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "bench": "tsx bench/render.bench.ts",
    "test:browser": "vitest run -c vitest.browser.config.ts"
  },
  "dependencies": {
    "@cutcraft/graphics": "workspace:*",
    "@cutcraft/kit": "workspace:*",
    "@cutcraft/player": "workspace:*",
    "@mediabunny/aac-encoder": "1.65.2",
    "@mediabunny/mp3-encoder": "1.65.2",
    "@puppeteer/browsers": "^3.2.6",
    "mediabunny": "catalog:",
    "playwright-core": "catalog:",
    "react": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "react-dom": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
