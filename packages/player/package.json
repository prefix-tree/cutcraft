{
  "name": "@cutcraft/player",
  "version": "0.1.0",
  "description": "Browser player for the cut video DSL: WebCodecs decode through mediabunny, canvas compositing, DOM overlays, Web Audio clock.",
  "keywords": [
    "video",
    "video-editing",
    "react",
    "tsx",
    "llm",
    "ai-video",
    "webcodecs",
    "player",
    "web-audio",
    "canvas"
  ],
  "license": "MIT",
  "homepage": "https://prefix-tree.github.io/cutcraft/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prefix-tree/cutcraft.git",
    "directory": "packages/player"
  },
  "bugs": {
    "url": "https://github.com/prefix-tree/cutcraft/issues"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./engine": "./src/engine.ts",
    "./overlays": "./src/overlays.ts",
    "./fonts.css": "./fonts.css"
  },
  "files": [
    "dist",
    "fonts.css"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.mjs",
      "./engine": "./dist/engine.mjs",
      "./overlays": "./dist/overlays.mjs",
      "./fonts.css": "./fonts.css"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/engine.ts src/overlays.ts --dts",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@cutcraft/graphics": "workspace:*",
    "@cutcraft/kit": "workspace:*",
    "@fontsource/dm-sans": "catalog:",
    "@fontsource/inter": "catalog:",
    "@fontsource/jetbrains-mono": "catalog:",
    "@fontsource/playfair-display": "catalog:",
    "@fontsource/space-grotesk": "catalog:",
    "mediabunny": "catalog:",
    "saxes": "^6.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
