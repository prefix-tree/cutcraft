{
  "name": "@cutcut/player",
  "version": "0.1.0",
  "private": true,
  "description": "Browser player for the cut video DSL: WebCodecs decode through mediabunny, canvas compositing, DOM overlays, Web Audio clock.",
  "license": "MIT",
  "homepage": "https://prefix-tree.github.io/cutcraft/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prefix-tree/cutcraft.git",
    "directory": "packages/player"
  },
  "bugs": {
    "url": "https://github.com/prefix-tree/cutcraft/issues"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./engine": "./src/engine.ts",
    "./overlays": "./src/overlays.ts",
    "./fonts.css": "./fonts.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@cutcut/graphics": "workspace:*",
    "@cutcut/kit": "workspace:*",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "mediabunny": "1.62.0",
    "saxes": "^6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
