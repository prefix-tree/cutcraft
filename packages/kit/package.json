{
  "name": "@uberscene/kit",
  "version": "0.5.0",
  "description": "The elements, components and helpers a UberScene video file is written with, and the vocabulary as data for tools.",
  "keywords": [
    "video",
    "video-editing",
    "react",
    "tsx",
    "llm",
    "ai-video",
    "timeline",
    "dsl"
  ],
  "license": "MIT",
  "homepage": "https://uberscene.prefixtree.xyz/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prefix-tree/uberscene.git",
    "directory": "packages/kit"
  },
  "bugs": {
    "url": "https://github.com/prefix-tree/uberscene/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./jsx-runtime": "react/jsx-runtime"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.mjs",
      "./schema": "./dist/schema.mjs",
      "./jsx-runtime": "react/jsx-runtime"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/schema.ts --dts",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:fonts": "tsx scripts/gen-font-catalog.ts"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
