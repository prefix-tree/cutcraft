{
  "name": "@cut/kit",
  "version": "0.1.0",
  "private": true,
  "description": "Vocabulary, resolver, action system and source tools for the cut video DSL.",
  "type": "module",
  "sideEffects": [
    "./src/actions/handlers/index.ts"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./source": "./src/source/index-public.ts",
    "./jsx-runtime": "react/jsx-runtime"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "parity": "tsx scripts/parity.ts",
    "bench": "tsx scripts/bench.ts"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "@babel/parser": "^7.29.9",
    "@babel/traverse": "^7.29.10",
    "@babel/types": "^7.29.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "eslint": "^9.0.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "tsx": "^4.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
