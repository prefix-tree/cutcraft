{
  "name": "@cutcraft/kit",
  "version": "0.1.0",
  "description": "Vocabulary, resolver, action system and source tools for the cut video DSL.",
  "license": "MIT",
  "homepage": "https://prefix-tree.github.io/cutcraft/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prefix-tree/cutcraft.git",
    "directory": "packages/kit"
  },
  "bugs": {
    "url": "https://github.com/prefix-tree/cutcraft/issues"
  },
  "type": "module",
  "sideEffects": [
    "./src/actions/handlers/index.ts",
    "./dist/**"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./source": "./src/source/index-public.ts",
    "./jsx-runtime": "react/jsx-runtime"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.mjs",
      "./source": "./dist/source/index-public.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/source/index-public.ts --dts",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "parity": "tsx scripts/parity.ts",
    "bench": "tsx scripts/bench.ts"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "@babel/parser": "^7.29.9",
    "@babel/traverse": "^7.29.10",
    "@babel/types": "^7.29.8",
    "@cutcraft/graphics": "workspace:*",
    "sucrase": "^3.35.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "tsx": "^4.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
