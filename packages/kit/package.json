{
  "name": "@cutcraft/kit",
  "version": "0.2.0",
  "description": "Vocabulary, resolver, action system and source tools for the cut video DSL.",
  "keywords": [
    "video",
    "video-editing",
    "react",
    "tsx",
    "llm",
    "ai-video",
    "timeline",
    "dsl",
    "resolver",
    "undo"
  ],
  "license": "MIT",
  "homepage": "https://prefix-tree.github.io/cutcraft/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prefix-tree/cutcraft.git",
    "directory": "packages/kit"
  },
  "bugs": {
    "url": "https://github.com/prefix-tree/cutcraft/issues"
  },
  "type": "module",
  "sideEffects": [
    "./src/actions/handlers/index.ts",
    "./dist/**"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./source": "./src/source/index-public.ts",
    "./jsx-runtime": "react/jsx-runtime"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.mjs",
      "./source": "./dist/source/index-public.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/source/index-public.ts --dts",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "tsx scripts/bench.ts"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "@babel/parser": "^7.29.9",
    "@babel/traverse": "^7.29.10",
    "@babel/types": "^7.29.8",
    "sucrase": "^3.35.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
