{
  "name": "@cutcraft/graphics",
  "version": "0.2.0",
  "description": "Ready-made graphics for CutCraft files (arrows, callouts, lower thirds, data graphics, backgrounds, icons) as pure functions from props and theme to SVG, and three.js and Motion on the video's clock for free code.",
  "keywords": [
    "video",
    "video-editing",
    "react",
    "tsx",
    "llm",
    "ai-video",
    "svg",
    "motion-graphics",
    "lower-third",
    "three",
    "motion",
    "animation"
  ],
  "license": "MIT",
  "homepage": "https://prefix-tree.github.io/cutcraft/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prefix-tree/cutcraft.git",
    "directory": "packages/graphics"
  },
  "bugs": {
    "url": "https://github.com/prefix-tree/cutcraft/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./libraries": "./src/libraries/index.ts",
    "./three": "./src/libraries/three.tsx",
    "./motion": "./src/libraries/motion.tsx"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.mjs",
      "./libraries": "./dist/libraries/index.mjs",
      "./three": "./dist/libraries/three.mjs",
      "./motion": "./dist/libraries/motion.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/libraries/index.ts src/libraries/three.tsx src/libraries/motion.tsx --dts",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:browser": "vitest run -c vitest.browser.config.ts"
  },
  "peerDependencies": {
    "@cutcraft/kit": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@cutcraft/kit": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@react-three/fiber": "9.4.0",
    "lucide": "^1.61.0",
    "motion": "12.23.24",
    "three": "0.180.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cutcraft/kit": "workspace:*",
    "@cutcraft/player": "workspace:*",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
