{
  "name": "@cutcraft/libraries",
  "version": "0.1.0",
  "description": "Libraries a cut file's free code may import, on the video's clock: three.js through React Three Fiber, and Motion.",
  "license": "MIT",
  "homepage": "https://prefix-tree.github.io/cutcraft/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prefix-tree/cutcraft.git",
    "directory": "packages/libraries"
  },
  "bugs": {
    "url": "https://github.com/prefix-tree/cutcraft/issues"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./three": "./src/three.tsx",
    "./motion": "./src/motion.tsx"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.mjs",
      "./three": "./dist/three.mjs",
      "./motion": "./dist/motion.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/three.tsx src/motion.tsx --dts",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:browser": "vitest run -c vitest.browser.config.ts"
  },
  "peerDependencies": {
    "@cutcraft/kit": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@react-three/fiber": "9.4.0",
    "motion": "12.23.24",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@cutcraft/kit": "workspace:*",
    "@cutcraft/player": "workspace:*",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
